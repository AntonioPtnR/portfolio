---
import ThemeToggle from "~/components/ui/ThemeToggle";
import { languages } from "~/i18n/ui";

interface Props {
  lang: string;
  t: (key: string) => string;
}

const { lang, t } = Astro.props;
const langEntries = Object.entries(languages);

const flags: Record<string, string> = {
  es: "🇪🇸",
  en: "🇬🇧",
  ca: "ca-svg",
};
---

<header class="navbar-glass sticky top-0 z-50 h-[72px] border-b border-[var(--color-border)] bg-[var(--color-bg)]/80 backdrop-blur-[12px]">
  <nav class="site-shell flex h-full items-center justify-between">
    <!-- Logo -->
    <a href={`/${lang}/`} class="flex items-center gap-1.5 text-lg font-bold tracking-tight">
      <span class="text-primary-400">&lt;/&gt;</span>
      <span>Antonio</span>
    </a>

    <!-- Desktop nav links -->
    <div class="hidden items-center gap-6 md:flex">
      <a href="#sobre-mi" class="nav-link text-sm font-medium text-[var(--color-text-tertiary)] hover:text-[var(--color-text)] transition-colors">
        {t("nav.sobre-mi")}
      </a>
      <a href="#formacion" class="nav-link text-sm font-medium text-[var(--color-text-tertiary)] hover:text-[var(--color-text)] transition-colors">
        {t("nav.formacion")}
      </a>
      <a href="#experiencia" class="nav-link text-sm font-medium text-[var(--color-text-tertiary)] hover:text-[var(--color-text)] transition-colors">
        {t("nav.experiencia")}
      </a>
      <a href="#portfolio" class="nav-link text-sm font-medium text-[var(--color-text-tertiary)] hover:text-[var(--color-text)] transition-colors">
        {t("nav.portfolio")}
      </a>
      <a href="#contacto" class="nav-link text-sm font-medium text-[var(--color-text-tertiary)] hover:text-[var(--color-text)] transition-colors">
        {t("nav.contacto")}
      </a>
    </div>

    <!-- Right controls -->
    <div class="flex items-center gap-3">
      <a
        href="/cv"
        class="hidden rounded-lg bg-[var(--color-primary)] px-3.5 py-1.5 text-xs font-semibold text-white shadow-sm hover:bg-[var(--color-primary-hover)] transition-colors sm:inline-flex items-center justify-center"
      >
        {t("nav.descargar-cv")}
      </a>

      <!-- Language switcher -->
      <div class="hidden items-center gap-1 sm:flex">
        {langEntries.map(([code, _name]) => {
          const isActive = code === lang;
          return (
            <a
              href={`/${code}/`}
              class={`flex items-center justify-center rounded-md w-8 h-7 text-sm leading-none transition-all duration-200 ${
                isActive
                  ? "bg-[var(--color-primary)]/15 ring-1 ring-[var(--color-primary)]/30 scale-105"
                  : "opacity-50 hover:opacity-100 hover:bg-[var(--color-surface-muted)]"
              }`}
              aria-label={t(`lang.${code}`)}
              aria-current={isActive ? "page" : undefined}
            >
              {code === "ca" ? (
                <span set:html={`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 18 12" class="h-3 w-[18px]"><rect width="18" height="12" fill="#FCDD09"/><rect y="0" width="18" height="2.4" fill="#DA121A"/><rect y="4.8" width="18" height="2.4" fill="#DA121A"/><rect y="9.6" width="18" height="2.4" fill="#DA121A"/></svg>`} />
              ) : (
                flags[code]
              )}
            </a>
          );
        })}
      </div>

      <ThemeToggle lang={lang} client:load />

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-btn"
        class="flex h-9 w-9 items-center justify-center rounded-lg text-[var(--color-text-secondary)] hover:bg-[var(--color-surface-muted)] md:hidden"
        aria-label={t("nav.abrir-menu")}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <svg id="menu-icon-close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden h-5 w-5">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
  </nav>
</header>

<!-- Mobile menu panel -->
<div
  id="mobile-menu"
  class="navbar-glass fixed inset-x-0 top-[72px] z-40 hidden border-b border-[var(--color-border)] bg-[var(--color-bg)]/95 backdrop-blur-[12px] md:hidden"
>
  <nav class="site-shell flex flex-col gap-2 py-4">
    <a href="#sobre-mi" class="mobile-link rounded-lg px-3 py-2 text-sm font-medium text-[var(--color-text-tertiary)] hover:bg-[var(--color-surface-muted)] hover:text-[var(--color-text)] transition-colors">
      {t("nav.sobre-mi")}
    </a>
    <a href="#formacion" class="mobile-link rounded-lg px-3 py-2 text-sm font-medium text-[var(--color-text-tertiary)] hover:bg-[var(--color-surface-muted)] hover:text-[var(--color-text)] transition-colors">
      {t("nav.formacion")}
    </a>
    <a href="#experiencia" class="mobile-link rounded-lg px-3 py-2 text-sm font-medium text-[var(--color-text-tertiary)] hover:bg-[var(--color-surface-muted)] hover:text-[var(--color-text)] transition-colors">
      {t("nav.experiencia")}
    </a>
    <a href="#portfolio" class="mobile-link rounded-lg px-3 py-2 text-sm font-medium text-[var(--color-text-tertiary)] hover:bg-[var(--color-surface-muted)] hover:text-[var(--color-text)] transition-colors">
      {t("nav.portfolio")}
    </a>
    <a href="#contacto" class="mobile-link rounded-lg px-3 py-2 text-sm font-medium text-[var(--color-text-tertiary)] hover:bg-[var(--color-surface-muted)] hover:text-[var(--color-text)] transition-colors">
      {t("nav.contacto")}
    </a>
    <a
      href="/cv.pdf"
      class="mt-1 inline-flex items-center justify-center rounded-lg bg-[var(--color-primary)] px-3.5 py-2 text-sm font-semibold text-white hover:bg-[var(--color-primary-hover)] transition-colors"
    >
      {t("nav.descargar-cv")}
    </a>

    <!-- Mobile language switcher -->
    <div class="mt-2 flex items-center gap-2 border-t border-[var(--color-border)] pt-3">
      {langEntries.map(([code, _name]) => {
        const isActive = code === lang;
        return (
          <a
            href={`/${code}/`}
            class={`flex items-center justify-center rounded-md w-9 h-8 text-sm leading-none transition-all duration-200 ${
              isActive
                ? "bg-[var(--color-primary)]/15 ring-1 ring-[var(--color-primary)]/30 scale-105"
                : "opacity-50 hover:opacity-100 hover:bg-[var(--color-surface-muted)]"
            }`}
            aria-label={t(`lang.${code}`)}
            aria-current={isActive ? "page" : undefined}
          >
            {code === "ca" ? (
              <span set:html={`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 18 12" class="h-3 w-[18px]"><rect width="18" height="12" fill="#FCDD09"/><rect y="0" width="18" height="2.4" fill="#DA121A"/><rect y="4.8" width="18" height="2.4" fill="#DA121A"/><rect y="9.6" width="18" height="2.4" fill="#DA121A"/></svg>`} />
            ) : (
              flags[code]
            )}
          </a>
        );
      })}
    </div>
  </nav>
</div>

<script>
  // Mobile menu toggle
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const openIcon = document.getElementById("menu-icon-open");
  const closeIcon = document.getElementById("menu-icon-close");

  if (btn && menu) {
    btn.addEventListener("click", () => {
      const isOpen = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!isOpen));
      menu.classList.toggle("hidden", isOpen);
      openIcon?.classList.toggle("hidden", !isOpen);
      closeIcon?.classList.toggle("hidden", isOpen);
    });

    // Close menu when a mobile link is clicked
    menu.querySelectorAll(".mobile-link").forEach((link) => {
      link.addEventListener("click", () => {
        btn.setAttribute("aria-expanded", "false");
        menu.classList.add("hidden");
        openIcon?.classList.remove("hidden");
        closeIcon?.classList.add("hidden");
      });
    });
  }

  // IntersectionObserver — active link highlighting
  const sections = document.querySelectorAll("section[id]");
  const navLinks = document.querySelectorAll(".nav-link");

  if (sections.length > 0 && navLinks.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            navLinks.forEach((link) => {
              const href = link.getAttribute("href");
              const isActive = href === `#${entry.target.id}`;
              link.classList.toggle("!text-[var(--color-primary)]", isActive);
              link.classList.toggle("!text-[var(--color-text-tertiary)]", !isActive);
            });
          }
        });
      },
      { rootMargin: "-80px 0px -60% 0px", threshold: 0 }
    );

    sections.forEach((section) => observer.observe(section));
  }
</script>
