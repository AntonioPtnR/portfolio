---
interface TimelineItem {
  title: string;
  subtitle: string;
  period: string;
  description?: string;
  highlights?: string[];
  tags?: string[];
}

interface Props {
  id?: string;
  title: string;
  icon: string;
  items: TimelineItem[];
  variant?: "alternating" | "stacked";
}

const { id, title, icon, items, variant = "alternating" } = Astro.props;

const sorted = items.sort((a, b) => {
  const aYear = parseInt(a.period.match(/\d{4}/)?.[0] ?? "0");
  const bYear = parseInt(b.period.match(/\d{4}/)?.[0] ?? "0");
  return bYear - aYear;
});

const isAlternating = variant === "alternating";
const altClass = isAlternating ? "alternating" : "";
---

<section {id} class="bg-[var(--color-surface)]">
  <div class="site-shell py-20 sm:py-28">
    <div class="mb-12 flex items-center gap-3 animate-fade-up" style="--i:0">
      <span class="text-2xl">{icon}</span>
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">{title}</h2>
    </div>

    <div class={`timeline-container ${altClass}`.trim()}>
      {
        sorted.map((item, idx) => (
          <div class={`timeline-entry ${altClass}`.trim()}>
            <!-- Dot on the timeline axis -->
            <div class={`timeline-dot ${altClass}`.trim()}></div>

            <!-- Card content -->
            <div
              class={`timeline-card ${altClass}`.trim() + " animate-fade-up"}
              style={`--i:${idx + 1}; animation-delay: ${(idx + 1) * 100}ms`}
            >
              <span class="text-xs font-semibold tracking-[0.15em] text-[var(--color-primary)] uppercase">{item.period}</span>
              <h3 class="mt-1 text-base font-semibold text-[var(--color-text)]">{item.title}</h3>
              <p class="text-sm text-[var(--color-text-secondary)]">{item.subtitle}</p>

              {item.description && (
                <p class="mt-2 text-sm text-[var(--color-text-tertiary)] leading-relaxed">{item.description}</p>
              )}

              {item.highlights && item.highlights.length > 0 && (
                <ul class="mt-3 space-y-1.5">
                  {item.highlights.map((h) => (
                    <li class="flex items-start gap-2 text-sm text-[var(--color-text-secondary)]">
                      <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-[var(--color-primary)]"></span>
                      {h}
                    </li>
                  ))}
                </ul>
              )}

              {item.tags && item.tags.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-1.5">
                  {item.tags.map((tag) => (
                    <span class="rounded-md border border-[var(--color-border)] bg-[var(--color-surface-muted)] px-2 py-0.5 text-xs font-medium text-[var(--color-text-tertiary)]">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  /* ── Timeline shared ── */
  .timeline-container {
    position: relative;
  }

  /* Vertical line — centered on desktop, left on mobile */
  .timeline-container::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-border);
  }

  .timeline-container:not(.alternating)::before {
    left: 15px;
  }

  @media (min-width: 768px) {
    .timeline-container.alternating::before {
      left: 50%;
      transform: translateX(-50%);
    }

    .timeline-container:not(.alternating)::before {
      left: 19px;
    }
  }

  /* ── Entry ── */
  .timeline-entry {
    position: relative;
    padding-bottom: 2.5rem;
  }

  .timeline-entry:last-child {
    padding-bottom: 0;
  }

  /* ── Dot ── */
  .timeline-dot {
    position: absolute;
    top: 0.375rem;
    height: 12px;
    width: 12px;
    border-radius: 50%;
    background: var(--color-primary);
    border: 3px solid var(--color-surface);
    z-index: 1;
    box-shadow: 0 0 8px rgba(59, 130, 246, 0.4);
  }

  .timeline-dot:not(.alternating) {
    left: 10px;
  }

  @media (min-width: 768px) {
    .timeline-dot.alternating {
      left: 50%;
      transform: translateX(-50%);
    }

    .timeline-dot:not(.alternating) {
      left: 15px;
    }
  }

  /* ── Card ── */
  .timeline-card {
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-bg);
    padding: 1.25rem;
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }

  [data-theme="light"] .timeline-card {
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.04),
      0 8px 30px rgba(15, 23, 42, 0.06);
  }

  .timeline-card:hover {
    border-color: rgba(59, 130, 246, 0.35);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  [data-theme="light"] .timeline-card:hover {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
  }

  .timeline-card:not(.alternating) {
    margin-left: 2.25rem;
  }

  @media (min-width: 640px) {
    .timeline-card:not(.alternating) {
      margin-left: 2.75rem;
    }
  }

  @media (min-width: 768px) {
    .timeline-card.alternating {
      width: calc(50% - 2rem);
    }

    /* Odd entries: left side */
    .timeline-entry.alternating:nth-child(odd) .timeline-card {
      margin-right: auto;
      margin-left: 0;
    }

    /* Even entries: right side */
    .timeline-entry.alternating:nth-child(even) .timeline-card {
      margin-left: auto;
      margin-right: 0;
    }
  }
</style>
