---
interface Props {
  t: (key: string) => string;
}

const { t } = Astro.props;
---

<div
  class="relative w-full max-w-[420px] rounded-xl border border-[rgba(59,130,246,0.25)] bg-[#0F172A] p-6 font-mono text-sm leading-relaxed shadow-[0_0_60px_rgba(59,130,246,0.1),0_0_30px_rgba(59,130,246,0.05)]"
>
  <!-- Window dots -->
  <div class="mb-4 flex items-center gap-2">
    <span class="h-3 w-3 rounded-full bg-red-500/80"></span>
    <span class="h-3 w-3 rounded-full bg-amber-400/80"></span>
    <span class="h-3 w-3 rounded-full bg-emerald-400/80"></span>
  </div>

  <!-- Terminal content -->
  <div class="space-y-1.5">
    <p>
      <span class="text-emerald-400">$</span>
      <span class="ml-2 text-white">whoami</span>
    </p>
    <p class="font-semibold text-[var(--color-primary)]">Antonio</p>
    <p class="text-slate-300">{t("terminal.rol")}</p>
    <p class="text-slate-400">{t("terminal.tags")}</p>

    <div class="py-1 text-slate-600 select-none">──────────────────</div>

    <p>
      <span class="text-emerald-400">✓</span>
      <span class="ml-2 text-slate-300">{t("terminal.experiencia")}</span>
    </p>
    <p>
      <span class="text-emerald-400">✓</span>
      <span class="ml-2 text-slate-300">{t("terminal.proyectos")}</span>
    </p>
    <p>
      <span class="text-emerald-400">✓</span>
      <span class="ml-2 text-slate-300">{t("terminal.arquitectura")}</span>
    </p>
    <p>
      <span class="text-emerald-400">✓</span>
      <span class="ml-2 text-slate-300">{t("terminal.aprendizaje")}</span>
    </p>

    <div class="pt-2">
      <span class="inline-block h-4 w-2 animate-pulse bg-[var(--color-primary)]"></span>
    </div>
  </div>
</div>
