---
import "~/styles/global.css";
import Header from "~/components/layout/Header.astro";
import Footer from "~/components/layout/Footer.astro";
import { languages, defaultLang, ogLocales } from "~/i18n/ui";

interface Props {
  lang: string;
  t: (key: string) => string;
}

const { lang, t } = Astro.props;

// Site base URL (falls back to hardcoded if Astro.site unavailable)
const site = Astro.site ?? new URL("https://antoniopaton.com");

// Canonical URL for current page
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, site).href;

// Hreflang alternates: replace language prefix in current path
const langPrefix = `/${lang}`;
const pathWithoutLang = pathname.startsWith(langPrefix)
  ? pathname.slice(langPrefix.length) || "/"
  : pathname;

const alternates = Object.keys(languages).map((code) => ({
  hreflang: code,
  href: new URL(`/${code}${pathWithoutLang}`, site).href,
}));

// x-default points to the default language version
const xDefaultHref = new URL(`/${defaultLang}${pathWithoutLang}`, site).href;

// OG locale for current language
const ogLocale = ogLocales[lang as keyof typeof ogLocales] ?? ogLocales[defaultLang];
const ogLocaleAlternates = Object.keys(languages)
  .filter((code) => code !== lang)
  .map((code) => ogLocales[code as keyof typeof ogLocales])
  .filter(Boolean);

// OG Image absolute URL
const ogImage = new URL("/og-image.jpg", site).href;

// JSON-LD structured data
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      name: "Antonio Patón Rico",
      jobTitle: t("about.subtitulo"),
      url: site.href,
      sameAs: [
        "https://github.com/AntonioPtnR",
        "https://linkedin.com/in/antoniopatonrico",
      ],
    },
    {
      "@type": "WebSite",
      url: site.href,
      name: t("seo.titulo"),
      description: t("seo.descripcion"),
      inLanguage: lang,
    },
  ],
};
---

<!doctype html>
<html lang={lang} class="scripting-enabled">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={t("seo.descripcion")} />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/jpeg" sizes="32x32" href="/avatar.jpg" />
    <link rel="canonical" href={canonical} />
    <title>{t("seo.titulo")}</title>

    <!-- Hreflang alternates -->
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <!-- Open Graph -->
    <meta property="og:title" content={t("seo.titulo")} />
    <meta property="og:description" content={t("seo.descripcion")} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    {ogLocaleAlternates.map((loc) => (
      <meta property="og:locale:alternate" content={loc} />
    ))}
    <meta property="og:site_name" content="Antonio Patón Rico — Portfolio" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1254" />
    <meta property="og:image:height" content="1254" />
    <meta property="og:image:alt" content={t("seo.titulo")} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t("seo.titulo")} />
    <meta name="twitter:title" content={t("seo.titulo")} />
    <meta name="twitter:description" content={t("seo.descripcion")} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

    <!-- Anti-FOUC: apply theme before first paint -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (stored === "dark" || (!stored && prefersDark)) {
          document.documentElement.setAttribute("data-theme", "dark");
        } else if (stored === "light") {
          document.documentElement.setAttribute("data-theme", "light");
        }
        // Always reveal, even if JS fails or is disabled
        document.documentElement.classList.replace("scripting-enabled", "theme-ready");
      })();
    </script>

    <!-- Fallback: reveal content if JS is disabled -->
    <noscript>
      <style>
        html.scripting-enabled { visibility: visible; }
      </style>
    </noscript>
  </head>
  <body class="min-h-screen bg-[var(--color-bg)] text-[var(--color-text)] antialiased transition-colors duration-300">
    <a href="#main-content" class="skip-link">{t("a11y.skip")}</a>
    <Header lang={lang} t={t} />
    <main id="main-content">
      <slot />
    </main>
    <Footer t={t} />
  </body>
</html>
