    },
    projects: [
      {
        title: "Nexfit",
        date: "In development",
        description:
          "End-to-end SaaS for personal trainers and nutritionists. NestJS, Next.js 16, Prisma, PostgreSQL, Expo. Offline-first mobile app for clients.",
      },
      {
        title: "Agro-pathON",
        date: "Design phase",
        description:
          "Automation of the digital field notebook for farmers. TypeScript, Next.js, PostgreSQL, Drizzle ORM.",
