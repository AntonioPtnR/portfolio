        ],
      },
      { role: "Software Development Specialist", date: "02/2024 — 08/2025", company: "Globalsuite Solutions" },
      { role: "Software Development Junior", date: "02/2023 — 02/2024", company: "Globalsuite Solutions" },
      { role: "Software Development Trainee", date: "02/2022 — 02/2023", company: "Globalsuite Solutions" },
    ],
    education: {
      title: "Grau en Enginyeria Informàtica",
      date: "2018 — 2022",
      company: "Universidad de Castilla-La Mancha",
      description:
        "Especialització en Tecnologies de la Informació. Algorísmia, estructures de dades, bases de dades, xarxes, sistemes operatius i metodologies àgils.",
    },
    projects: [
      {
        title: "Nexfit",
        date: "En desenvolupament",
        description:
          "SaaS integral per a entrenadors personals i nutricionistes. NestJS, Next.js 16, Prisma, PostgreSQL, Expo. App mòbil offline-first per a clients.",
      },
      {
        title: "Agro-pathON",
        date: "En fase de disseny",
